# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgres

# RAG
RAG_TOP_K=3
RAG_VECTOR_SEARCH_ENABLED=true
RAG_MIN_SIMILARITY_SCORE=0.4
RAG_RERANK_ENABLED=false
RAG_GROUNDEDNESS_THRESHOLD=0.7
RAG_GROUNDEDNESS_FALLBACK_ENABLED=true

# Auth
APP_JWT_SECRET=change-this-jwt-secret-in-production-at-least-32-bytes
APP_JWT_ISSUER=llm-rag-platform
APP_JWT_EXPIRATION_SECONDS=3600
AUDIT_ADMIN_USERNAME=admin
AUDIT_ADMIN_PASSWORD=change-me
AUDIT_OPERATOR_USERNAME=operator
AUDIT_OPERATOR_PASSWORD=change-operator

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
